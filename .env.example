# -----------------------------------------------------------------------------
# AI Configuration (inference providers)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_SANDBOX_API_KEY=your_gemini_sandbox_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# XAI_API_KEY=your_xai_api_key_here

# -----------------------------------------------------------------------------
# Text-to-speech (Google Cloud TTS)
# -----------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=your_google_application_credentials_here
# -----------------------------------------------------------------------------
# Live data (OpenWeatherMap, football-data.org, GNews)
# -----------------------------------------------------------------------------
# OPENWEATHER_API_KEY=your_openweathermap_api_key_here
# TARGET_LOCATION=your_city_state_country_here
# FOOTBALL_API_KEY=your_football_data_org_api_key_here
# GNEWS_API_KEY=your_gnews_api_key_here

# -----------------------------------------------------------------------------
# Networking (optional configured-network policy for advisory preflight)
# -----------------------------------------------------------------------------
# HOME_SSID=your_home_wifi_ssid_here

# -----------------------------------------------------------------------------
# Browser / launcher (Full path to Chromium-based .exe)
# Machine-specific paths (Brave, Vivaldi, etc.) belong here.
# -----------------------------------------------------------------------------
# CUSTOM_BROWSER_PATH=your_custom_browser_path_here

# -----------------------------------------------------------------------------
# Scanner / runtime
# -----------------------------------------------------------------------------
# Optional LiteRT-LM local provider. The managed Python 3.11 worker is used
# only when enabled; model artifacts are installed separately.
# LITERT_ENABLED=false
# LITERT_PYTHON_EXECUTABLE=C:\path\to\.venv-litert\Scripts\python.exe
# LITERT_MODEL_DIR=C:\path\to\APEX\models\litert

# Unified development mode (optional; defaults to false if unset).
# When true: suppresses configured-network warnings and production run logging.
# Gmail/Calendar remain live with masked content; model behavior uses DEV_AI_SYNTHESIS.
DEV_MODE=false

# Synthesis control flag - Evaluated ONLY when DEV_MODE=true
# Options:
#   raw (uses deterministic, sanitized Structured Digest output)
#   cloud (uses Panthera through the live OpenAI Responses API)
#   local (local Ollama synthesis with deterministic raw fallback)
# Briefing route in DEV_MODE: cloud (Panthera -> Mus -> Sorex -> raw), local (local -> raw), raw
DEV_AI_SYNTHESIS=raw

# Text-to-Speech audio control flag - Evaluated ONLY when DEV_MODE=true
# Options:
#   pyttsx3 (default local playground execution baseline - offline)
#   google (forces fall-through execution to live cloud Google TTS client API)
#   kokoro (local Kokoro ONNX model playback)
DEV_TTS_PLAYBACK=pyttsx3

# Legacy scanner.should_run() gate (optional; defaults to true if unset).
# API trigger and telemetry routes use advisory preflight and ignore this setting.
ENABLE_STARTUP_GATE=true

# Architecture Offline Isolation & Simulation (optional; defaults to false if unset).
# When true: intercepts trigger requests, simulates pipeline latency stages, 
# and returns high-contrast mock data from core/mock/telemetry.json.
DEMO_MODE=false

# Text-to-Speech playback engine override used ONLY when DEMO_MODE=true.
# Options:
#   pyttsx3 (default offline local engine)
#   google (forces playout via live cloud Google TTS client API)
#   kokoro (local Kokoro ONNX model playback)
DEMO_TTS=pyttsx3

# -----------------------------------------------------------------------------
# CORS (optional, comma-separated origins for the web HUD)
# Defaults to loopback and localhost on ports 8000, 5500, and 5173.
# Set this if you serve the HUD from a different port. Custom values fully
# replace the defaults — they are not merged.
# -----------------------------------------------------------------------------
# APEX_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5173,http://localhost:5173

# -----------------------------------------------------------------------------
# EOD market ticker (Alpha Vantage). Optional.
# When either value is unset outside demo mode, GET /api/v1/market returns an
# empty not-configured response. DEMO_MODE supplies simulated market data.
# -----------------------------------------------------------------------------
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
# MARKET_SYMBOLS=your_comma_separated_ticker_symbols_here

# -----------------------------------------------------------------------------
# External MCP credentials (optional)
# Referenced by name from config.json / config.local.json under
# mcp.servers.<id>.auth_env or mcp.servers.<id>.header_env.
# Do not put tokens in config files. Tracked presets currently cover GitHub,
# Brave Search, and Alpha Vantage; enablement lives in Runtime Settings.
# -----------------------------------------------------------------------------
# GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
# BRAVE_API_KEY=your_brave_api_key_here
# Alpha Vantage MCP uses browser-based OAuth and stores its authorization in
# the operating system credential manager. The existing HUD ticker continues
# to use ALPHA_VANTAGE_API_KEY above.

# Microsoft To Do (optional read-only assistant integration)
# Register a public/native Microsoft application, enable device-code flow, and
# grant delegated Tasks.Read. No client secret is used.
# MICROSOFT_TODO_CLIENT_ID=your_public_application_client_id
# MICROSOFT_TODO_TENANT_ID=common
# Optional machine-specific encrypted cache location outside the repository:
# MICROSOFT_TODO_TOKEN_CACHE_PATH=C:\path\to\microsoft_todo_token_cache.bin
