{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "development-main-capability",
  "description": "Development access is limited to the Vite origin.",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:5173"] },
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-desktop-setup-status",
    "allow-desktop-import-pick-source",
    "allow-desktop-import-preview",
    "allow-desktop-import-commit",
    "allow-desktop-fresh-start",
    "allow-desktop-import-recover",
    "allow-desktop-backend-status",
    "allow-desktop-backend-retry",
    "allow-desktop-quit",
    "allow-desktop-services-status",
    "allow-desktop-services-retry",
    "allow-desktop-open-external",
    "allow-desktop-write-clipboard"
  ]
}
