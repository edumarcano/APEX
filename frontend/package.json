{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run && node --test scripts/check-loading.node-test.mjs scripts/prepare-desktop.node-test.mjs",
    "test:watch": "vitest",
    "build": "tsc -b && vite build",
    "check:loading": "node scripts/check-loading.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && npm run tauri -- dev --config src-tauri/tauri.dev.conf.json",
    "tauri": "tauri",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.1",
    "@tauri-apps/api": "2.8.0",
    "@lobehub/icons": "^5.16.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tauri-apps/cli": "2.8.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
